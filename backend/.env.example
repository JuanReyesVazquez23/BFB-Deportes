# Copia este archivo como ".env" en la carpeta backend/ y completa tus valores reales.
# NUNCA subas el archivo .env (con secretos reales) a un repositorio público.

ENV=development

# --- Base de datos PostgreSQL ---
DATABASE_URL=postgresql+psycopg2://bfb_user:bfb_password@localhost:5432/bfb_deportes

# --- Seguridad ---
# Genera una clave aleatoria única, por ejemplo con:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_ALEATORIA_Y_SECRETA

# --- APIs externas ---
# MLB Stats API no requiere API key.
# balldontlie.io (basketball: NBA/WNBA/NCAAB): crea una cuenta gratis en https://balldontlie.io
# Nota: el nivel gratuito de balldontlie NO incluye la mayoría de ligas de
# fútbol ni el Mundial (dan 401 Unauthorized) — por eso el fútbol usa un
# proveedor distinto (ver abajo).
BALLDONTLIE_API_KEY=

# football-data.org (fútbol: EPL, La Liga, Serie A, Bundesliga, Ligue 1,
# Champions League, Mundial): gratis para siempre, sin tarjeta de crédito.
# Crea tu token en https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# --- API-Football (api-sports.io) — TODAVÍA NO conectada en el código ---
# Para estadísticas completas de jugadores de fútbol (no solo goleadores).
# Gratis, sin tarjeta: https://www.api-football.com/ (o vía RapidAPI).
API_FOOTBALL_KEY=

# --- CORS: dominios desde los que se permite consumir la API ---
# En producción, reemplaza por el dominio real de tu frontend.
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:8000"]

# --- Panel de administración (borrar equipos incorrectos a mano) ---
# Tu(s) username(s) de BFB Deportes (el mismo con el que inicias sesión en
# el sitio), separados por coma si hay más de uno. Vacío = nadie tiene
# acceso al panel, ni siquiera viéndolo en el código fuente del sitio.
ADMIN_USERNAMES=
